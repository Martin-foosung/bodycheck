{
  "expo": {
    "name": "BodyCheck",
    "slug": "bodycheck",
    "version": "2.4.2",
    "scheme": "bodycheck",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.bodycheck.health",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F8FB"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "주변 의료기관 안내를 위해 현재 위치를 사용합니다."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "ce2ebeeb-45c3-48c7-96b0-bdb6b8e98ad8"
      }
    }
  }
}