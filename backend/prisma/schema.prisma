generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  createdAt    DateTime           @default(now())
  records      HealthRecord[]
  favorites    FavoriteHospital[]
}

model HealthRecord {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  bodyPath    Json
  bodyPart    String
  symptom     String
  intensity   Int?
  onset       String?
  duration    String?
  trend       String?
  answers     Json?
  riskLevel   String?
  department  String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model FavoriteHospital {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  ykiho        String
  hospitalName String
  address      String?
  createdAt    DateTime @default(now())

  @@unique([userId, ykiho])
}